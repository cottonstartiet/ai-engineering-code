# Copy to .env. Do not commit credentials. API keys from chat should be rotated.
POSTGRES_PASSWORD=support-local-demo
DATABASE_URL=postgresql+psycopg://support:support-local-demo@db:5432/support
AZURE_OPENAI_ENDPOINT=https://res-eval-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_KEY=
# A SEPARATE embedding deployment is required; the chat deployment cannot embed.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MAX_GROUP_TURNS=12
TRANSIENT_RETRIES=2
INVESTIGATION_TIMEOUT_SECONDS=120
JOB_LEASE_SECONDS=180
WORKER_CONCURRENCY=2
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://dashboard:18889
CAPTURE_SYNTHETIC_PAYLOADS=false
# Optional approximate USD pricing; leave unset when unknown.
# INPUT_PRICE_PER_MILLION=
# OUTPUT_PRICE_PER_MILLION=
DATA_DIRECTORY=/app/data
